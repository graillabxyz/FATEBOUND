// Copied beside a frozen src/ by the coordinator, never imported by the client.
import {writeFileSync} from 'node:fs';
import {simulateGame} from './src/dev/simulation';
import {STARTERS} from './src/content/loadouts';
import {omenById} from './src/content/omens';
import {LEGENDS} from './src/content/legends';
import {GAME} from './src/content/config';
import type {LegendId,Loadout} from './src/engine/types';
const [id,idx,total,base,out,custom]=process.argv.slice(2),a=id as LegendId,n=Number(total),seed=Number(base),rows:any[]=[];
// The frozen worker uses independently curated legal Hands in the custom pass.
const variants=custom==='true'?JSON.parse((await import('node:fs')).readFileSync(`${out}/custom-hands.json`,'utf8')):null;
for(const [j,l] of LEGENDS.entries()){
 const r:any={legend:a,opponent:l.id,games:0,wins:0,losses:0,draws:0,openingGames:0,openingWins:0,secondGames:0,secondWins:0,rounds:0,damage:0,ward:0,focus:0,held:0,expired:0,reactions:0,reactionSuccess:0,turns:0,initiativeWins:0,openingDraws:0,secondDraws:0,blankRolls:0,totalRolls:0,fullHoldTurns:0,openingChoices:{},openingDamage:[0,0],mismatches:0,cards:{},opponentCards:{},byHand:{},version:GAME.version};let previous:any=null;
 for(let i=0;i<n;i++){
  const build=(legend:LegendId,offset:number):Loadout=>variants?{...STARTERS[legend],...variants[legend][(offset===0?Math.floor(i/2):Math.floor(Math.floor(i/2)/variants[a].length))%variants[legend].length]}:STARTERS[legend];
  const record=simulateGame({loadouts:[build(a,0),build(l.id,1)],games:n,seed:seed+(Number(idx)*6+j)*10000,paired:true,difficulty:'Normal'},i),seat=i%2,other=1-seat;
  const hand=record.loadouts[seat].cards.join(' / '), h=r.byHand[hand]??={games:0,wins:0,draws:0,damage:0,ward:0,reactions:0};h.games++;h.wins+=+(record.winner===seat);h.draws+=+(record.winner==='draw');for(const st of record.stats){h.damage+=st.damage[seat];h.ward+=st.guard[seat];h.reactions+=st.reactions?.[seat]??0;}
  r.games++;r.rounds+=record.rounds;r.wins+=+(record.winner===seat);r.losses+=+(record.winner===other);r.draws+=+(record.winner==='draw');
  const first=record.openingInitiative!.winner===seat;if(first){r.openingGames++;r.openingWins+=+(record.winner===seat);r.openingDraws+=+(record.winner==='draw');}else{r.secondGames++;r.secondWins+=+(record.winner===seat);r.secondDraws+=+(record.winner==='draw');}
  r.initiativeWins+=+(record.winner===record.openingInitiative!.winner);
  for(const t of record.turnHistory.filter(t=>t.actor===seat)){
    if(t.completed&&t.held===t.slots.length&&t.slots.length)r.fullHoldTurns++;
    if(t.playerTurnCount<=2)r.openingDamage[t.playerTurnCount-1]+=t.damage[seat];
    if(t.playerTurnCount===1){const choice=t.slots.map(slot=>record.loadouts[seat].dice[slot]).sort().join(' + ');const row=r.openingChoices[choice]??={games:0,wins:0};row.games++;row.wins+=+(record.winner===seat);}
  }
  for(const st of record.stats)for(const f of st.faces[seat]){const [id,pos]=f.split(':');r.totalRolls++;if(omenById[id].faces[Number(pos)].type==='blank')r.blankRolls++;}
  for(const st of record.stats){for(const [key,field] of Object.entries({damage:'damage',ward:'guard',focus:'control',held:'held',expired:'expired',reactions:'reactions',reactionSuccess:'reactionSuccess',turns:'turns'}))r[key]+=(st as any)[field]?.[seat]??0;for(const c of st.cards[seat])r.cards[c]=(r.cards[c]??0)+1;for(const c of st.cards[other])r.opponentCards[c]=(r.opponentCards[c]??0)+1;}
  const normalized={winner:record.winner==='draw'?'draw':record.winner===seat?'focal':'opponent',hp:[record.hp[seat],record.hp[other]],rounds:record.rounds};
  if(i%2===0)previous=normalized;else if(JSON.stringify(previous)!==JSON.stringify(normalized))r.mismatches++;
  if((i+1)%1000===0){writeFileSync(`${out}/${a}-progress.json`,JSON.stringify({legend:a,opponent:l.id,completed:j*n+i+1,total:n*6}));console.log(`${a} ${j*n+i+1}/${n*6}`);}
 }
 rows.push(r);writeFileSync(`${out}/${a}.json`,JSON.stringify(rows,null,2));
}
